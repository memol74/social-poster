{
  "youtube": {
    "client_secret_file": "client_secret.json"
  },
  "instagram": {
    "app_id": "YOUR_IG_APP_ID",
    "app_secret": "YOUR_IG_APP_SECRET",
    "fb_app_id": "YOUR_FB_APP_ID",
    "fb_app_secret": "YOUR_FB_APP_SECRET"
  },
  "tiktok": {
    "client_key": "YOUR_TIKTOK_CLIENT_KEY",
    "client_secret": "YOUR_TIKTOK_CLIENT_SECRET",
    "redirect_uri": "https://your-domain.example/tiktok-callback"
  },
  "linkedin": {
    "client_id": "YOUR_LINKEDIN_CLIENT_ID",
    "client_secret": "YOUR_LINKEDIN_CLIENT_SECRET",
    "post_as": "organization",
    "scopes": "w_organization_social",
    "person_id": "OPTIONAL_IF_USERINFO_WORKS",
    "organization_id": "YOUR_LINKEDIN_ORGANIZATION_ID",
    "redirect_uri": "http://localhost:8585/callback"
  }
}
